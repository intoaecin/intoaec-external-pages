{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "build": {
    "env": {
      "GENERATE_SOURCEMAP": "false",
      "NODE_OPTIONS": "--max-old-space-size=4096"
    }
  },
  "env": {
    "NODE_OPTIONS": "--max-http-header-size=65536"
  }
}
